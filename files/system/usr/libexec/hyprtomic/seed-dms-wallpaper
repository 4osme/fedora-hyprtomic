#!/usr/bin/env bash
# Seed the DMS wallpaper from the skel background, once.
#
# DMS keeps its session (including the wallpaper) in
# ~/.local/state/dms/session.json. Only add `wallpaperPath` when it is missing,
# so the control-center wallpaper picker and per-monitor mode keep working and
# a user choice is never overwritten on login.
set -u

session="${XDG_STATE_HOME:-$HOME/.local/state}/dms/session.json"
wallpaper="$HOME/.local/share/backgrounds/wallpaper.jpg"

[ -f "$wallpaper" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

if jq -e 'has("wallpaperPath")' "$session" >/dev/null 2>&1; then
    exit 0
fi

mkdir -p "$(dirname "$session")"
if [ -f "$session" ]; then
    jq --arg p "$wallpaper" '.wallpaperPath = $p' "$session" >"$session.tmp" &&
        mv "$session.tmp" "$session"
else
    printf '{"wallpaperPath": "%s"}\n' "$wallpaper" >"$session"
fi
