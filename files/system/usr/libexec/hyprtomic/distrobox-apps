#!/usr/bin/env bash
# Keep the host launcher (DMS) in sync with the GUI applications installed in
# distrobox containers. Runs on the host:
#
#   hyprtomic-distrobox-apps            # one pass (ujust refresh-distrobox-apps)
#   hyprtomic-distrobox-apps --watch    # systemd user service, polls every 15s
#
# Every pass asks each *running* container for its visible .desktop files. When
# that set changes (a package was installed or removed, an entry was hidden, an
# app was deleted) the entries are re-exported into ~/.local/share/applications
# and stale exports from this script are removed. A stopped container keeps its
# exports so it can still be launched from the launcher on demand.
#
# Only exports carrying X-HyprTomic-Container=<name> are ever pruned, so
# hand-written .desktop files and distrobox's own <container>.desktop entries
# are never touched.
set -uo pipefail

APPS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hyprtomic/distrobox-apps"
MARKER="X-HyprTomic-Container="
INTERVAL="${HYPRTOMIC_DISTROBOX_APPS_INTERVAL:-15}"

log() { printf '%s\n' "$*"; }

# Shell snippet executed *inside* the container. It computes the set of
# exportable .desktop files, compares it with the last pass (state file on the
# host, reached through /run/host) and re-exports only when it changed.
INNER_SCRIPT=$(cat <<'INNER'
set -u
state="${HYPRTOMIC_STATE:-}"
[ -n "$state" ] || exit 1
host_state="/run/host${state}"
tmp="${host_state}.new.$$"

# Use the exact source path: --app NAME does a fuzzy Name/Exec search and
# misses desktop IDs that differ from the binary name (e.g. google-chrome).
mkdir -p "$tmp.dir" || exit 1
trap 'rm -rf "$tmp.dir" "$tmp" "$tmp.hash"' EXIT
: > "$tmp"
: > "$tmp.hash"
failed=0
changed=0
old_ifs=$IFS
IFS=:
set -f
set -- ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
set +f
IFS=$old_ifs
for root in "${XDG_DATA_HOME:-$HOME/.local/share}" "$@"; do
    case "$root" in /run/host/*|*/flatpak/exports/share) continue ;; esac
    for f in "$root"/applications/*.desktop; do
        [ -f "$f" ] || continue
        id=${f##*/}
        [ ! -e "$tmp.dir/$id" ] || continue
        : > "$tmp.dir/$id"
        grep -q '^Type=Application' "$f" || continue
        grep -q '^Exec=' "$f" || continue
        grep -qE '^(Hidden=true|Exec=.*(distrobox|host-spawn))' "$f" && continue
        # NoDisplay handlers are still valid choices for xdg-open.
        sum=$(cksum < "$f") || exit 1
        row="$sum $id"
        out="/run/host${HYPRTOMIC_APPS}/${HYPRTOMIC_NAME}-$id"
        printf '%s\n' "$id" >> "$tmp"
        printf '%s\n' "$row" >> "$tmp.hash"
        if [ -f "$out" ] && grep -Fxq "$row" "$host_state.hash" 2>/dev/null; then
            continue
        fi
        raw="/run/host${DISTROBOX_HOST_HOME:-$HOME}/.local/share/applications/${HYPRTOMIC_NAME}-$id"
        if distrobox-export --app "$f" >/dev/null &&
            { [ "$raw" = "$out" ] || mv -f "$raw" "$out"; } &&
            sed -i "/^\[Desktop Entry\]$/a X-HyprTomic-Container=${HYPRTOMIC_NAME}" "$out"; then
            changed=1
        else
            failed=1
        fi
    done
done
[ "$failed" -eq 0 ] || exit 1
if [ "$changed" = 0 ] && cmp -s "$host_state" "$tmp"; then
    echo unchanged
else
    mv "$tmp" "$host_state" && mv "$tmp.hash" "$host_state.hash" || exit 1
    echo updated
fi
INNER
)

if command -v distrobox-enter >/dev/null 2>&1; then
    ENTER_CMD=(distrobox-enter -n)
else
    ENTER_CMD=(distrobox enter -n)
fi

# Remove exports whose source .desktop file disappeared from the container.
prune_container_exports() {
    local name="$1" state="$2" f base src
    [ -f "$state" ] || return 0
    for f in "$APPS_DIR/${name}-"*.desktop; do
        [ -f "$f" ] || continue
        grep -Fxq "${MARKER}${name}" "$f" || continue
        grep -qE '^Exec=.*(distrobox-enter|distrobox enter)' "$f" || continue
        base="$(basename "$f")"
        src="${base#"$name"-}"
        grep -qxF "$src" "$state" && continue
        rm -f "$f"
        log "removed stale export: $base"
    done
}

# Drop exports of containers that no longer exist. Stopped containers stay in
# `distrobox list`, so their entries survive until the container is removed.
prune_removed_containers() {
    local known="$1" f name
    for f in "$APPS_DIR"/*.desktop; do
        [ -f "$f" ] || continue
        name="$(sed -n "s/^${MARKER}\\([^ ]*\\)$/\\1/p" "$f" | head -n 1)"
        [ -n "$name" ] || continue
        printf '%s\n' "$known" | grep -qxF "$name" && continue
        rm -f "$f"
        dirty=1
        log "removed export of removed container '$name'"
    done
}

sync_container() {
    local name="$1" state="${STATE_DIR}/${1}.list" result
    mkdir -p "$STATE_DIR"
    # /dev/null is deliberate: distrobox-enter must not eat the loop's stdin.
    result="$(timeout 150 "${ENTER_CMD[@]}" "$name" -- \
        env HYPRTOMIC_STATE="$state" HYPRTOMIC_APPS="$APPS_DIR" HYPRTOMIC_NAME="$name" sh -lc "$INNER_SCRIPT" </dev/null 2>&1)" || {
            log "container '$name' did not answer: $result"
            return 1
        }
    case "$result" in
        unchanged*)
            return 0
            ;;
        updated*)
            dirty=1
            prune_container_exports "$name" "$state"
            log "$name: $result"
            ;;
        partial*)
            log "$name: $result"
            ;;
        *)
            log "$name: $result"
            ;;
    esac
    return 0
}

sync() {
    command -v distrobox >/dev/null 2>&1 || { log "distrobox not found; skipping"; return 1; }
    mkdir -p "$STATE_DIR"
    local lock
    exec {lock}>"$STATE_DIR/sync.lock"
    flock -n "$lock" || return 0
    local all running c listing dirty=0
    listing="$(distrobox list --no-color)" || return 1
    all="$(awk -F' *\\| *' 'NR > 1 && NF >= 3 { print $2 }' <<< "$listing")"
    # A successful header-only listing means the last box was removed.
    [[ "$listing" == *'|'* ]] || return 1

    mkdir -p "$APPS_DIR" "$STATE_DIR"
    running="$(awk -F' *\\| *' 'NR > 1 && $3 ~ /^Up/ { print $2 }' <<< "$listing")"
    while IFS= read -r c; do
        [ -n "$c" ] || continue
        sync_container "$c" || true
    done <<< "$running"

    prune_removed_containers "$all"
    if ((dirty)) && command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
    fi
}

watch() {
    mkdir -p "$STATE_DIR"
    exec 9>"${STATE_DIR}/watch.lock"
    flock -n 9 || { log "another watcher is already running; exiting"; return 0; }
    while :; do
        (sync) || true
        sleep "$INTERVAL"
    done
}

case "${1:-}" in
    --watch) watch ;;
    --once|"") sync ;;
    *) log "usage: hyprtomic-distrobox-apps [--watch|--once]"; exit 2 ;;
esac
