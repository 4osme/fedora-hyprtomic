[Unit]
Description=Sunshine game streaming host (JIS build, manual start)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/sunshine
Restart=on-failure
RestartSec=5s

# No [Install]: `sunshine-session start` starts the unit on demand. Starting it
# at login would keep the encoder probing the desktop while nobody streams.
