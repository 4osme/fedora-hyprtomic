#%PAM-1.0
# HyprTomic: empty submit opens one bounded fingerprint window (10s, single
# try); a typed password skips the reader entirely.
auth     [success=1 default=ignore] pam_exec.so quiet quiet_log expose_authtok /usr/libexec/hyprtomic/pam-fingerprint-gate
auth     [success=done default=ignore] pam_fprintd.so timeout=10 max-tries=1
auth     required      pam_unix.so

account  include       system-auth
password include       system-auth
session  include       system-auth
